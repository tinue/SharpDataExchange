#!/bin/sh
#
# Remote execution wrapper for SharpDataExchange (sder)
# Workaround for macOS USB/Serial RTS/CTS bug on PC-1600.
#
# V2.0.0, 2026-03-08
#

REMOTE_HOST="desktoppi.home.erzi.ch"
REMOTE_JAR="/tmp/SharpDataExchange.jar"
REMOTE_DIR="/tmp"

# Find the JAR relative to this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
JAR_FILE="$SCRIPT_DIR/SharpDataExchange.jar"

if [ ! -f "$JAR_FILE" ]; then
    echo "Error: $JAR_FILE not found. Run 'mvn install' first."
    exit 1
fi

VERB=$1
shift

case "$VERB" in
    put)
        # Find the first argument that exists as a local file.
        # This allows options like --device pc1600 to come before or after the file.
        FILE=""
        for arg in "$@"; do
            if [ -f "$arg" ]; then
                FILE="$arg"
                break
            fi
        done

        if [ -z "$FILE" ]; then
            echo "Error: No local file found in arguments."
            echo "Usage: sder put [options] <file>"
            exit 1
        fi
        
        BASENAME=$(basename -- "$FILE")
        
        echo "Transferring $FILE and JAR to $REMOTE_HOST..."
        # Use ./ prefix to protect scp if filename starts with -
        scp "$FILE" "$REMOTE_HOST:$REMOTE_DIR/$BASENAME"
        scp "$JAR_FILE" "$REMOTE_HOST:$REMOTE_JAR"
        
        echo "Executing remotely..."
        # Pass all original arguments, but replace the local FILE path with the remote path
        # We replace the first occurrence of the filename with the remote path.
        REMOTE_ARGS=""
        REPLACED=0
        for arg in "$@"; do
            if [ "$REPLACED" -eq 0 ] && [ "$arg" = "$FILE" ]; then
                REMOTE_ARGS="$REMOTE_ARGS $REMOTE_DIR/$BASENAME"
                REPLACED=1
            else
                REMOTE_ARGS="$REMOTE_ARGS $arg"
            fi
        done
        ssh "$REMOTE_HOST" "java -jar $REMOTE_JAR put $REMOTE_ARGS"
        ;;
    get)
        echo "Transferring JAR to $REMOTE_HOST..."
        scp "$JAR_FILE" "$REMOTE_HOST:$REMOTE_JAR"
        
        echo "Executing remotely..."
        # Execute and capture stdout
        ssh "$REMOTE_HOST" "java -jar $REMOTE_JAR get $@" > .sder_out
        cat .sder_out
        
        # Extract filename from "Saving to PROG.bas"
        SAVED_FILE=$(grep -i "Saving to" .sder_out | sed 's/.*Saving to //i' | xargs)
        rm .sder_out
        
        if [ -n "$SAVED_FILE" ]; then
            echo "Fetching $SAVED_FILE from $REMOTE_HOST..."
            scp "$REMOTE_HOST:$SAVED_FILE" .
        else
            echo "Could not detect saved filename from remote output."
        fi
        ;;
    terminal)
        echo "Transferring JAR to $REMOTE_HOST..."
        scp "$JAR_FILE" "$REMOTE_HOST:$REMOTE_JAR"
        
        echo "Executing remotely..."
        ssh -t "$REMOTE_HOST" "java -jar $REMOTE_JAR terminal $@"
        ;;
    *)
        echo "Usage: sder get|put|terminal [options]"
        exit 1
        ;;
esac
