#!/bin/bash
#
# Release script for SharpDataExchange
# Uses 'gh' CLI to create a GitHub release or prerelease.
#

# Stop on error
set -e

# Parse arguments
IS_PRERELEASE=true
if [[ "$1" == "--release" ]]; then
    IS_PRERELEASE=false
fi

# 1. Get version from pom.xml
VERSION=$(grep -m 1 "<version>" pom.xml | sed -E 's/.*<version>(.*)<\/version>.*/\1/')
TAG="v$VERSION"

echo "Preparing release for version $VERSION (tag: $TAG)..."

# 2. Extract release notes from CHANGELOG.md
# Extracts text between ## [VERSION] and the next ##
NOTES=$(sed -n "/## \[$VERSION\]/,/## /p" CHANGELOG.md | sed '1d;$d')

if [ -z "$NOTES" ]; then
    echo "Error: Could not find release notes for version $VERSION in CHANGELOG.md"
    exit 1
fi

# 3. Clean build
echo "Building JAR..."
mvn clean package -DskipTests

JAR_FILE="target/SharpDataExchange.jar"
if [ ! -f "$JAR_FILE" ]; then
    echo "Error: JAR file not found at $JAR_FILE"
    exit 1
fi

# 4. Create/Update Release using gh CLI
echo "Creating GitHub ${IS_PRERELEASE:+pre}release..."

PRERELEASE_FLAG=""
if [ "$IS_PRERELEASE" = true ]; then
    PRERELEASE_FLAG="--prerelease"
fi

# Check if release already exists
if gh release view "$TAG" >/dev/null 2>&1; then
    echo "Updating existing release $TAG..."
    gh release edit "$TAG" --notes "$NOTES" $PRERELEASE_FLAG
    gh release upload "$TAG" "$JAR_FILE" --clobber
else
    echo "Creating new release $TAG..."
    gh release create "$TAG" "$JAR_FILE" --title "$TAG" --notes "$NOTES" $PRERELEASE_FLAG
fi

echo "Done."
