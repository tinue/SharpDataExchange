#!/bin/bash
#
# Release script for SharpDataExchangeRust.
#
# Unlike a local build, the actual cross-platform artifacts are produced by
# .github/workflows/release.yml. This script's job is to run the local checks and
# to push the tag that triggers that workflow — the workflow then builds every
# platform and creates the GitHub release.
#
# The macOS job also Developer-ID-signs + notarizes the binaries and builds a
# notarized, stapled .pkg installer; it needs the APPLE_* repo secrets described
# in .github/macos-signing.md.
#
# Full release-cycle recipe ("release this version"):
#
#   bin/release            # 1. pre-release: finalize CHANGELOG date, push "vX.Y.Z-pre",
#                           #    wait for CI to build + publish the pre-release
#   bin/release --release  # 2. only once step 1's CI is green: promote to the real
#                           #    "vX.Y.Z" release, verify it published correctly
#   bin/release --next     # 3. only once step 2 is verified: cut "dev-X.Y.(Z+1)" from
#                           #    main, bump manifests, open a "- WIP" CHANGELOG section
#
# Stop and report rather than retrying if any step fails — see each mode's
# pre-conditions below; some of these steps aren't safe to blindly re-run once
# partially applied.
#
# Individual modes:
#
#   1. Local build + test only (no git/GitHub interaction):
#        bin/release --build-only
#
#   2. Pre-release (push a disposable "vX.Y.Z-pre" tag; CI publishes a GitHub
#      pre-release you can re-cut as often as you like while iterating):
#        bin/release
#      Pre-conditions: not on main; no staged-but-uncommitted changes; branch is
#      in sync with its remote; branch fast-forward-merges into main; CHANGELOG.md
#      has an entry for the current version.
#      Also: if that CHANGELOG entry's date is still the "WIP" placeholder (or
#      missing), it is stamped with today's date, committed, and pushed before
#      the tag goes out — this only happens once; a real date is never
#      overwritten by a later re-run. After pushing the tag, this waits for the
#      triggered CI run to finish (build jobs run ~1-3 min, the final publish
#      job ~11s) and aborts with the failing run's id if it doesn't succeed.
#
#   3. Full release (squash-merge branch -> main, tag "vX.Y.Z" on main; promotes
#      the "vX.Y.Z-pre" pre-release's already-built assets to the real GitHub
#      release — no rebuild, CI is not re-triggered; the "-pre" tag/release is
#      then deleted):
#        bin/release --release
#      Pre-conditions: not on main; working tree clean; a "vX.Y.Z-pre" GitHub
#      pre-release exists for this version.
#      Note pushing the real tag does NOT trigger CI (only "-pre" tags do), so
#      there is no Actions run to wait for here; instead this verifies the
#      published GitHub release itself has all expected assets.
#
#   4. Start the next cycle (from main: cut "dev-X.Y.(Z+1)", bump Cargo.toml,
#      open a new "## [X.Y.(Z+1)] - WIP" CHANGELOG section, commit, push):
#        bin/release --next
#      Pre-condition: "dev-X.Y.(Z+1)" must not already exist locally or on origin.
#      Always a plain patch bump of whatever version is on main's Cargo.toml.
#
# Append --dry-run to any invocation to preview state-changing actions.
#
# Prerequisites:  Rust toolchain, and for 2/3:  gh  (brew install gh; gh auth login)
#

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────

CHANGELOG="CHANGELOG.md"
MAIN_BRANCH="main"
REPO_URL="https://github.com/tinue/SharpDataExchangeRust"

VERSION=$(grep -m 1 '^version[[:space:]]*=' Cargo.toml | sed -E 's/.*"([^"]+)".*/\1/')
if [ -z "${VERSION:-}" ]; then
    echo "Error: could not read version from Cargo.toml"
    exit 1
fi
TAG="v$VERSION"
PRE_TAG="v${VERSION}-pre"

# ── Argument parsing ─────────────────────────────────────────────────────────────

DO_BUILD_ONLY=false
DO_RELEASE=false
DO_NEXT=false
DRY_RUN=false

for arg in "$@"; do
    case "$arg" in
        --build-only) DO_BUILD_ONLY=true ;;
        --release)    DO_RELEASE=true ;;
        --next)       DO_NEXT=true ;;
        --dry-run)    DRY_RUN=true ;;
        *) echo "Unknown argument: $arg"; exit 1 ;;
    esac
done

MODE_COUNT=0
$DO_BUILD_ONLY && MODE_COUNT=$((MODE_COUNT + 1))
$DO_RELEASE    && MODE_COUNT=$((MODE_COUNT + 1))
$DO_NEXT       && MODE_COUNT=$((MODE_COUNT + 1))
if [ "$MODE_COUNT" -gt 1 ]; then
    echo "Error: --build-only, --release, and --next are mutually exclusive."
    exit 1
fi

run_cmd() {
    if $DRY_RUN; then
        echo "[dry-run] $*"
    else
        "$@"
    fi
}

# ── Unstaged-changes helper ────────────────────────────────────────────────────
#
# Unstaged changes are the one pre-condition we recover from: offer to stash and
# restore via the EXIT trap. Staged-but-uncommitted changes and unpushed commits
# still hard-abort.

STASHED=false
restore_stash() {
    if $STASHED; then
        echo "Restoring stashed changes…"
        git stash pop
    fi
}
trap restore_stash EXIT

stash_unstaged_changes() {
    if ! git diff --quiet; then
        echo "Unstaged changes present:"
        git status --short
        read -p "Stash them and restore after release finishes? (yes/no) " -r
        if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
            echo "Aborted: commit or stash unstaged changes first."
            exit 1
        fi
        run_cmd git stash push -m "bin/release autostash"
        $DRY_RUN || STASHED=true
    fi
}

changelog_notes() {
    # Print the CHANGELOG section body for $VERSION, trimmed of blank
    # leading/trailing lines (may be empty if there is no such section).
    awk -v v="$VERSION" '
        $0 ~ "^## \\[" v "\\]" { grab=1; next }
        grab && (/^## / || /^\[[^][]+\]: /) { exit }
        grab {
            if (!started && $0 ~ /^[[:space:]]*$/) next
            started = 1
            buf = buf $0 "\n"
        }
        END {
            sub(/\n+$/, "\n", buf)
            printf "%s", buf
        }
    ' "$CHANGELOG"
}

# Replace "## [$VERSION] - WIP" (or a bare "## [$VERSION]") with today's date.
# A no-op if the header already carries a real date — never overwrites one.
finalize_changelog_date() {
    if ! grep -qE "^## \[$VERSION\]( - WIP)?\$" "$CHANGELOG"; then
        return 0
    fi
    local today
    today=$(date +%Y-%m-%d)
    echo "Setting $CHANGELOG release date for $VERSION to ${today}…"
    run_cmd sed -i.bak -E "s/^## \[$VERSION\]( - WIP)?\$/## [$VERSION] - $today/" "$CHANGELOG"
    run_cmd rm -f "$CHANGELOG.bak"
    run_cmd git add "$CHANGELOG"
    run_cmd git commit -m "Set $VERSION release date to $today"
    run_cmd git push
}

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# ── 4. Next cycle ─────────────────────────────────────────────────────────────
#
# Standalone: no local build/test (nothing to test yet) and no `gh` calls
# (pure git + file edits), so this runs before those preambles.

if $DO_NEXT; then
    stash_unstaged_changes
    if ! git diff --cached --quiet; then
        echo "Error: staged but uncommitted changes present. Commit them first."
        git status --short
        exit 1
    fi

    echo "Fetching ${MAIN_BRANCH}…"
    run_cmd git fetch origin "$MAIN_BRANCH" --quiet
    run_cmd git checkout "$MAIN_BRANCH"
    run_cmd git merge --ff-only "origin/$MAIN_BRANCH"

    if $DRY_RUN; then
        # checkout/merge above were no-ops under --dry-run, so Cargo.toml here
        # is still whatever branch we started on; use the top-of-file reading
        # as an approximation for preview purposes only.
        CUR_VERSION="$VERSION"
    else
        CUR_VERSION=$(grep -m 1 '^version[[:space:]]*=' Cargo.toml | sed -E 's/.*"([^"]+)".*/\1/')
    fi
    IFS=. read -r NEXT_MAJ NEXT_MIN NEXT_PAT <<< "$CUR_VERSION"
    NEXT_VERSION="$NEXT_MAJ.$NEXT_MIN.$((NEXT_PAT + 1))"
    NEXT_BRANCH="dev-$NEXT_VERSION"

    if git show-ref --verify --quiet "refs/heads/$NEXT_BRANCH"; then
        echo "Error: branch '$NEXT_BRANCH' already exists locally."
        exit 1
    fi
    if git ls-remote --exit-code --heads origin "$NEXT_BRANCH" &>/dev/null; then
        echo "Error: branch '$NEXT_BRANCH' already exists on origin."
        exit 1
    fi

    echo "Starting $NEXT_VERSION on branch $NEXT_BRANCH (from $MAIN_BRANCH @ $CUR_VERSION)…"
    run_cmd git checkout -b "$NEXT_BRANCH"

    run_cmd sed -i.bak -E "s/^version([[:space:]]*=[[:space:]]*)\"$CUR_VERSION\"/version\1\"$NEXT_VERSION\"/" Cargo.toml
    run_cmd rm -f Cargo.toml.bak
    run_cmd cargo check --quiet

    if $DRY_RUN; then
        echo "[dry-run] would insert '## [$NEXT_VERSION] - WIP' section and update compare links in $CHANGELOG"
    else
        awk -v nextver="$NEXT_VERSION" -v curver="$CUR_VERSION" -v repo="$REPO_URL" '
            {
                if ($0 == "## [Unreleased]") {
                    print
                    print ""
                    print "## [" nextver "] - WIP"
                    next
                }
                if ($0 ~ /^\[Unreleased\]: /) {
                    print "[Unreleased]: " repo "/compare/v" nextver "...HEAD"
                    print "[" nextver "]: " repo "/compare/v" curver "...v" nextver
                    next
                }
                print
            }
        ' "$CHANGELOG" > "$CHANGELOG.tmp"
        mv "$CHANGELOG.tmp" "$CHANGELOG"
    fi

    run_cmd git add Cargo.toml Cargo.lock "$CHANGELOG"
    run_cmd git commit -m "Bump version to $NEXT_VERSION"
    run_cmd git push -u origin "$NEXT_BRANCH"

    if $DRY_RUN; then
        echo "Done.  [dry-run] No changes made."
    else
        echo "Done.  $NEXT_BRANCH is checked out and pushed, starting $NEXT_VERSION."
        echo "  CHANGELOG.md's '## [$NEXT_VERSION] - WIP' section is where new entries go;"
        echo "  running 'bin/release' will replace WIP with the real date on the first pre-release."
    fi
    exit 0
fi

# ── 1. Local build + test ──────────────────────────────────────────────────────

echo "SharpDataExchange $VERSION  (tag: $TAG)"
echo "Running local checks…"
run_cmd cargo clippy --all-targets --all-features -- -D warnings
run_cmd cargo build --release
run_cmd cargo test

if $DO_BUILD_ONLY; then
    echo "Done.  Build-only: artifacts in target/release/"
    exit 0
fi

# ── gh presence ───────────────────────────────────────────────────────────────

if ! command -v gh &>/dev/null; then
    echo "Error: 'gh' CLI not found. Install with: brew install gh"
    exit 1
fi

# ── 3. Full release ───────────────────────────────────────────────────────────

if $DO_RELEASE; then
    if [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ]; then
        echo "Error: --release must run from a development branch, not '$MAIN_BRANCH'."
        exit 1
    fi

    stash_unstaged_changes
    if ! git diff --cached --quiet; then
        echo "Error: staged but uncommitted changes present. Commit them first."
        git status --short
        exit 1
    fi

    if ! gh release view "$PRE_TAG" &>/dev/null; then
        echo "Error: no GitHub pre-release '$PRE_TAG'. Run 'bin/release' first."
        exit 1
    fi
    if ! gh release view "$PRE_TAG" --json isPrerelease -q .isPrerelease | grep -q true; then
        echo "Error: '$PRE_TAG' exists but is not a pre-release. Nothing to promote."
        exit 1
    fi

    read -p "Have CHANGELOG.md and Cargo.toml version been finalized for $VERSION? (yes/no) " -r
    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        echo "Aborted."
        exit 1
    fi

    NOTES=$(changelog_notes)
    [ -z "$NOTES" ] && NOTES="Release $TAG. See CHANGELOG.md."
    COMMIT_MSG="Release $TAG"$'\n\n'"${NOTES}"
    # The tag pushed below only matches "-pre" in release.yml's trigger, so it
    # does not start a new build — the pre-release's assets are promoted as-is.
    # This squash commit's own push to main would still fire CI's build + test
    # + cross-build matrix on code the pre-release build already exercised, so
    # skip it too.
    COMMIT_MSG="${COMMIT_MSG}"$'\n\n''skip-ci: identical to the already-built pre-release'
    COMMIT_MSG="${COMMIT_MSG}"$'\n''[skip ci]'

    echo "Downloading ${PRE_TAG}'s already-built assets…"
    DIST_DIR=$(mktemp -d)
    run_cmd gh release download "$PRE_TAG" --dir "$DIST_DIR" --clobber
    if ! $DRY_RUN && [ -z "$(ls -A "$DIST_DIR" 2>/dev/null)" ]; then
        echo "Error: no assets found on pre-release ${PRE_TAG}."
        rm -rf "$DIST_DIR"
        exit 1
    fi
    if $DRY_RUN; then
        EXPECTED_COUNT=0
    else
        EXPECTED_COUNT=$(ls -1 "$DIST_DIR" | wc -l | tr -d ' ')
    fi

    echo "Squash-merging $CURRENT_BRANCH into ${MAIN_BRANCH}…"
    run_cmd git fetch origin "$MAIN_BRANCH" --quiet
    run_cmd git checkout "$MAIN_BRANCH"
    run_cmd git merge --ff-only "origin/$MAIN_BRANCH" || true
    run_cmd git merge --squash "$CURRENT_BRANCH"
    run_cmd git commit -m "$COMMIT_MSG"
    run_cmd git push origin "$MAIN_BRANCH"

    # Braced ${MAIN_BRANCH}, not $MAIN_BRANCH: this bash mis-parses a bare
    # $VAR immediately followed by a multi-byte UTF-8 character (here "…") as
    # part of the variable name, raising a spurious "unbound variable" error.
    echo "Tagging $TAG on ${MAIN_BRANCH}…"
    run_cmd git tag "$TAG"
    run_cmd git push origin "$TAG"
    run_cmd git checkout "$CURRENT_BRANCH"

    NOTES_FILE=$(mktemp)
    printf '%s\n' "$NOTES" > "$NOTES_FILE"
    echo "Publishing release ${TAG} (promoting ${PRE_TAG}'s assets, no rebuild)…"
    run_cmd gh release create "$TAG" "$DIST_DIR"/* \
        --title "SharpDataExchange $VERSION" \
        --notes-file "$NOTES_FILE"
    rm -f "$NOTES_FILE"
    rm -rf "$DIST_DIR"

    echo "Removing pre-release ${PRE_TAG}…"
    run_cmd gh release delete "$PRE_TAG" --yes --cleanup-tag

    if $DRY_RUN; then
        echo "Done.  [dry-run] No changes made."
        exit 0
    fi

    # Pushing the real tag does not trigger CI (only "-pre" tags do), so there
    # is no Actions run to wait for here — verify the release object itself.
    echo "Verifying published release ${TAG}…"
    ASSET_COUNT=$(gh release view "$TAG" --json assets --jq '.assets | length')
    if [ "$ASSET_COUNT" -lt "$EXPECTED_COUNT" ]; then
        echo "Error: release $TAG has $ASSET_COUNT asset(s), expected $EXPECTED_COUNT (from $PRE_TAG)."
        echo "  main and the tag are already updated; only the asset upload is incomplete."
        echo "  Retry manually:  gh release upload $TAG <missing files>"
        exit 1
    fi
    if [ "$(gh release view "$TAG" --json isDraft -q .isDraft)" = "true" ]; then
        echo "Error: release $TAG was created as a draft unexpectedly."
        exit 1
    fi

    echo "Done.  Release ${TAG}: $(gh release view "${TAG}" --json url -q .url)  ($ASSET_COUNT assets)"
    exit 0
fi

# ── 2. Pre-release ────────────────────────────────────────────────────────────

if [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ]; then
    echo "Error: pre-release must run from a development branch, not '$MAIN_BRANCH'."
    exit 1
fi

stash_unstaged_changes
if ! git diff --cached --quiet; then
    echo "Error: staged but uncommitted changes present. Commit them first."
    git status --short
    exit 1
fi

UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
if [ -z "$UPSTREAM" ]; then
    echo "Error: branch '$CURRENT_BRANCH' has no upstream. Run: git push -u origin $CURRENT_BRANCH"
    exit 1
fi

finalize_changelog_date

if [ "$(git rev-parse HEAD)" != "$(git rev-parse "$UPSTREAM")" ]; then
    AHEAD=$(git rev-list --count "${UPSTREAM}..HEAD")
    if [ "$AHEAD" -gt 0 ]; then
        echo "Error: $AHEAD unpushed commit(s) on '$CURRENT_BRANCH'. Push before releasing."
    else
        echo "Error: '$CURRENT_BRANCH' is behind '$UPSTREAM'. Pull before releasing."
    fi
    exit 1
fi

git fetch origin "$MAIN_BRANCH" --quiet
MAIN_SHA=$(git rev-parse "origin/$MAIN_BRANCH")
if [ "$(git merge-base HEAD "origin/$MAIN_BRANCH")" != "$MAIN_SHA" ]; then
    echo "Error: '$CURRENT_BRANCH' cannot be fast-forward merged into $MAIN_BRANCH."
    echo "  Merge or rebase onto $MAIN_BRANCH first:  git merge origin/$MAIN_BRANCH"
    exit 1
fi

if [ ! -f "$CHANGELOG" ]; then
    echo "Error: $CHANGELOG not found."
    exit 1
fi
if [ -z "$(changelog_notes)" ]; then
    echo "Error: no '## [$VERSION]' entry in $CHANGELOG. Add one before releasing."
    exit 1
fi

echo ""
echo "── Release notes for $PRE_TAG (from $CHANGELOG) ────────────"
changelog_notes
echo "──────────────────────────────────────────────────────────"
echo ""
read -p "Push tag '$PRE_TAG' at $(git rev-parse --short HEAD) and let CI publish the pre-release? (yes/no) " -r
if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
    echo "Aborted."
    exit 1
fi

SHA=$(git rev-parse HEAD)

# -f: the -pre tag is disposable and moves to the latest pre-release commit.
run_cmd git tag -f "$PRE_TAG"
run_cmd git push -f origin "$PRE_TAG"

if $DRY_RUN; then
    echo "Done.  [dry-run] No changes made."
    exit 0
fi

echo "Waiting for CI run triggered by $PRE_TAG (commit ${SHA:0:7})…"
RUN_ID=""
for _ in $(seq 1 30); do
    RUN_ID=$(gh run list --workflow=release.yml --event=push \
        --json databaseId,headSha,createdAt \
        --jq "[.[] | select(.headSha == \"$SHA\")] | sort_by(.createdAt) | last | .databaseId // empty" \
        2>/dev/null || true)
    [ -n "$RUN_ID" ] && break
    sleep 2
done
if [ -z "$RUN_ID" ]; then
    echo "Error: no CI run for $PRE_TAG (commit ${SHA:0:7}) appeared within 60s."
    echo "  Check manually:  gh run list --workflow=release.yml"
    exit 1
fi

echo "Found run $RUN_ID — waiting for it to finish (build jobs ~1-3 min, publish ~11s)…"
if ! gh run watch "$RUN_ID" --exit-status; then
    echo "Error: CI run $RUN_ID for $PRE_TAG failed."
    echo "  View logs:   gh run view $RUN_ID --log-failed"
    echo "  Fix the problem, then re-run 'bin/release' to re-cut $PRE_TAG."
    exit 1
fi

echo "Done.  CI run $RUN_ID succeeded — $PRE_TAG is published."
