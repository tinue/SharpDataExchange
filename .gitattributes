# The tokenizer works on raw bytes, and the byte-parity fixtures under
# tests/fixtures/ assume LF-only source listings. Force LF in the working tree on
# every platform so a Windows checkout does not turn each newline into CR + LF and
# add a stray 0x0D to every tokenized line.
* text=auto eol=lf

# Binary fixtures and any other binary payloads: never touch them.
*.bin binary
# Device files copied off a PC-1600 disk: CRLF and the 1A end byte are the content.
*.PUN binary

# Shell scripts and the release helper stay LF and executable.
*.sh text eol=lf
bin/release text eol=lf
